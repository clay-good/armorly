{
  "name": "armorly",
  "version": "2.11.0",
  "private": true,
  "description": "Test harness for the Armorly browser extension. The extension itself has no build step.",
  "scripts": {
    "build": "./build.sh chrome",
    "pretest": "./build.sh chrome",
    "test": "node --test tests/unit/ && playwright test",
    "test:unit": "node --test tests/unit/",
    "demo": "ARMORLY_DEMO=1 playwright test --grep @demo",
    "stills": "ARMORLY_DEMO=1 playwright test --grep @demo && ./scripts/make-listing-stills.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
